<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="template_verification_email" model="mail.template">
            <field name="name">[DHL] Xác thực tài khoản của bạn</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">[DHL] Xác thực tài khoản của {{ object.company_id.name }}</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="description">Invitation email to contacts to create a user account</field>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0" style="padding: 16px; background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
                    <tr>
                        <td align="center">
                            <div style="background-color: white; padding: 16px; border-radius: 4px;">
                                <p style="font-size: 16px;">Xin chào <t t-out="object.name or 'Người dùng'"/>!</p>
                                <p>Chào mừng đến với <t t-out="object.company_id.name"/>!</p>
                                <div style="margin: 20px 0; text-align: center;">
                                    <a t-att-href="object.generate_verification_url()" 
                                       style="display: inline-block; padding: 12px 24px; text-decoration: none; font-size: 14px; background-color: #FFCC00; color: #D40511; border-radius: 4px; border: 2px solid #D40511; font-weight: bold;">
                                        XÁC THỰC NGAY
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>
    </data>
</odoo>