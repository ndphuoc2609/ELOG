<odoo>
    <data>
        <record id="view_assign_driver_wizard" model="ir.ui.view">
            <field name="name">assign.driver.wizard.form</field>
            <field name="model">assign.driver.wizard</field>
            <field name="arch" type="xml">
                <form string="Assign Driver">
                    <group>
                        <group>
                            <field name="shift_id"/>
                            <field name="shift_start"/>
                        </group>
                        <group>
                            <field name="transport_type"/>
                            <field name="shift_end"/>
                        </group>
                    </group>
                    <footer>
                        <button string="Assign" type="object" name="assign_driver" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>