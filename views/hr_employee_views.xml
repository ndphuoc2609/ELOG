<odoo>
    <data>
        <record id="view_drivers_map" model="ir.ui.view">
            <field name="name">drivers.map.view</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <drivers fieldFromTheArch="name"/>
            </field>
        </record>

        <record id="view_drivers_kanban" model="ir.ui.view">
            <field name="name">drivers.kanban.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//ul" position="inside">
                    <ul>
                        <li class="mb4" t-if="record.warehouse_id.raw_value" title="Warehouse">
                            <i class="fa fa-cubes" role="img" aria-label="Warehouse"/> <field name="warehouse_id"/>
                        </li>
                    </ul>
                </xpath>
            </field>
        </record>

        <record id="view_drivers_form" model="ir.ui.view">
            <field name="name">drivers.form.view</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_location_id']" position="after">
                    <field name="warehouse_id"/>
                </xpath>
            </field>
        </record>

        <record id="view_drivers_search" model="ir.ui.view">
            <field name="name">drivers.search</field>
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <search string="Drivers">
                    <field name="name"/>
                    <field name="work_phone"/>
                    <field name="work_email"/>
                    <field name="warehouse_id"/>
                    <filter string="Working" name="is_working" domain="[('is_working', '=', True)]"/>
                    <separator/>
                    <filter string="Online" name="driver_is_online" domain="[('driver_is_online', '=', True)]"/>
                </search>
            </field>
        </record>
    
        <record id="action_drivers" model="ir.actions.act_window">
            <field name="name">Drivers</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">drivers,kanban,form</field>
            <field name="search_view_id" ref="view_drivers_search"/>
            <field name="domain">[('job_id.name', '=', 'Driver')]</field>
        </record>

        <record model="ir.actions.act_window.view" id="action_drivers_map">
            <field name="sequence" eval="1"/>
            <field name="view_mode">drivers</field>
            <field name="view_id" ref="view_drivers_map"/>
            <field name="act_window_id" ref="action_drivers"/>
        </record>
    </data>
</odoo>